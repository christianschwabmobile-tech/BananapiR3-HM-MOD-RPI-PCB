#!/bin/sh /etc/rc.common

START=40
STOP=90
USE_PROCD=1

wait_device() {
	local dev="$1"
	local n=0

	while [ ! -e "$dev" ] && [ "$n" -lt 30 ]; do
		sleep 1
		n=$((n + 1))
	done

	[ -e "$dev" ]
}

start_service() {
	wait_device /dev/raw-uart || return 1
	wait_device /dev/eq3loop || return 1

	procd_open_instance
	procd_set_param command \
		/bin/sh -c \
		'ulimit -n 512; exec /usr/bin/multimacd -f /etc/config/multimacd.conf -l 3'

	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
